<Window x:Class="DoubleFileCheckerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoubleFileCheckerWPF"
        xmlns:conv="clr-namespace:DoubleFileCheckerWPF.Converters"
        xmlns:vm="clr-namespace:DoubleFileCheckerWPF.ViewModels"
        xmlns:model="clr-namespace:DoubleFileCheckerWPF.Model" d:DataContext="{d:DesignInstance Type=model:FileGroupViewModel}"
        mc:Ignorable="d"
        Title="Double File Checker" Height="450" Width="800">

   

    <Grid>
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem Header="_Open" Click="OpenFolder"/>
                    <MenuItem Header="_Exit" Click="Exit_Click"/>
                </MenuItem>
                <MenuItem Header="_Optionen">
                    <MenuItem Header="Rekursiv"
                              IsChecked="{Binding RecursiveEnabled}"
                              IsCheckable="True" />
                    <Separator/>

                    <MenuItem Header="Nur Duplikate anzeigen" 
                              IsChecked="{Binding DuplicatesEnabled}"
                              IsCheckable="True" />
                    <Separator/>
                    <MenuItem Header="Nur Bilder" 
                              IsChecked="{Binding NurBilderEnabled}"
                              IsCheckable="True" />
                    <Separator/>

                </MenuItem>
                <MenuItem Header="_Löschen" Click="DeleteSelected_Click" />
            </Menu>

            <DataGrid x:Name="myDataGrid"
                      ItemsSource="{Binding GroupedImages}"
                      AutoGenerateColumns="False"
                      EnableRowVirtualization="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                      >

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Visibility" Value="Visible"/>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Media" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <vm:ListBoxControl 
                                    Items="{Binding Images}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    d:DataContext="{d:DesignInstance Type=model:FileGroupViewModel}"
                                    DataContext="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <StatusBar Name="sbar" 
           VerticalAlignment="Bottom" Background="Beige" >

            <StatusBarItem>
                <TextBlock>Datei:</TextBlock>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="ActualFile" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>